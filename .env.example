# Copy to .env.local and adjust as needed. Never commit real .env files.

# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Local open-weight model used to propose organization plans.
# TidyMate never downloads models; install it with: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b

# How long to wait for the model before giving up, in milliseconds.
# Gemma 3 4B can take a few minutes on CPU-only machines.
OLLAMA_TIMEOUT_MS=300000
